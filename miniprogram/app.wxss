page {
  background: #f6f2ec;
  color: #2f2a24;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.demo-banner {
  margin: 0 0 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff4e6;
  color: #9a5b1f;
  font-size: 22rpx;
  border: 1rpx solid #f3d9b8;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.section-title .hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8378;
}

.card {
  background: #fffdf9;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(87, 63, 40, 0.06);
}

.btn-primary {
  background: #b4553a;
  color: #fff8f3;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn-ghost {
  background: #fffdf9;
  color: #b4553a;
  border: 1rpx solid #e2c3b3;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn-primary[disabled] {
  background: #d9c7bd;
  color: #fffdf9;
}

.empty {
  padding: 96rpx 24rpx;
  text-align: center;
  color: #9a9288;
  font-size: 26rpx;
}

.price {
  color: #b4553a;
  font-weight: 600;
}

.tag-preview {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #2f2a24;
  color: #f6f2ec;
  font-size: 20rpx;
  margin-left: 8rpx;
}

.muted {
  color: #9a9288;
  font-size: 24rpx;
}
